<div class="row-span-2 grid row-subgrid place-center">
	<label class="pointer hover-glow" data-action="check" data-type="proficiency" data-path="{{ path }}">
		{{localize (concat "warden.character.FIELDS." path ".label")}}
		(
		{{~numberFormat
			bonus
			sign=true
		~}}
		)
	</label>
	<div class="diamonds pointer" data-action="clickChanger" data-path="{{concat 'system.' path '.rank'}}">
		{{> warden-diamonds
			num=5
			filled=rank
		}}
	</div>
</div>
