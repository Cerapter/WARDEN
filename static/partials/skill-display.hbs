<span class="pointer" data-action="toggleValue" data-path="system.skill.{{ name }}.is_proficient">
	{{> warden-diamond
		filled=is_proficient
	}}
</span>
<span
	class="grid col-span-2 col-subgrid pointer hover-glow"
	data-action="check"
	data-type="skill"
	data-skill="{{ name }}"
>
	<span class="text-right">
		{{~numberFormat
			bonus
			sign=true
		~}}
	</span>
	<span>{{localize (concat "warden.character.FIELDS.skill." name ".name")}}</span>
</span>
