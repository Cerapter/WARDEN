<span data-action="deleteKnowledgeSkill" data-id="{{ id }}"><i class="fa-solid fa-trash-can"></i></span>
<span class="grid col-span-2 col-subgrid" data-action="check" data-type="knowledge" data-id="{{ id }}">
	<span class="text-right">
		{{~numberFormat
			skill.bonus
			sign=true
		~}}
	</span>
	<span>
		<input type="text" name="system.knowledge_skills.{{ id }}.topic" value="{{ skill.topic }}" />
	</span>
</span>
