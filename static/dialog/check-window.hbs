<section class="check-window">
	<div class="modifiers">
		{{#each parameters.modifiers}}
			<label
				class="grid col-subgrid col-span-4 align-center pointer"
				data-action="toggleModifier"
				data-id="{{ @index }}"
			>
				<span class="text-right">
					{{~numberFormat
						value
						sign=true
					~}}
				</span>
				<span>{{ label }}</span>
				<span class="text-center" title='{{localize (concat "warden.modifier_type." type)}}'>
					{{localize (concat "warden.modifier_type_abbr." type)}}
				</span>
				<input
					class="grid place-center"
					type="checkbox"
					{{checked enabled}}
				/>
			</label>
		{{/each}}
		<hr class="col-span-4" />
		<form class="add-modifier-form grid col-subgrid col-span-4">
			<input class="text-right" type="number" name="value" value="{{ pending_modifier.value }}" />
			<input
				type="text"
				name="label"
				value="{{ pending_modifier.label }}"
				placeholder="{{localize 'warden.modifier_label'}}"
			/>
			<select name="type">
				{{selectOptions
					choices
					selected=pending_modifier.type
					localize=true
				}}
			</select>
			<button type="submit"><i class="fa-solid fa-plus"></i></button>
		</form>
	</div>

	<div class="difficulty-grid text-center">
		<span class="pointer tl {{ifThen (eq parameters.difficulty 10) 'active' ''}}" data-action="setDifficulty" data-difficulty="10">{{localize "warden.roll.difficulty.standard"}}</span>
		<span class="pointer {{ifThen (eq parameters.difficulty 15) 'active' ''}}" data-action="setDifficulty" data-difficulty="15">{{localize "warden.roll.difficulty.difficult"}}</span>
		<span class="pointer {{ifThen (eq parameters.difficulty 20) 'active' ''}}" data-action="setDifficulty" data-difficulty="20">{{localize "warden.roll.difficulty.daunting"}}</span>
		<span class="pointer {{ifThen (eq parameters.difficulty 25) 'active' ''}}" data-action="setDifficulty" data-difficulty="25">{{localize "warden.roll.difficulty.extreme"}}</span>
		<span class="pointer tr {{ifThen (eq parameters.difficulty 30) 'active' ''}}" data-action="setDifficulty" data-difficulty="30">{{localize "warden.roll.difficulty.impossible"}}</span>
		<span class="col-span-5 pointer b {{ifThen (eq parameters.difficulty 'open') 'active' ''}}" data-action="setDifficulty" data-difficulty="open">{{localize "warden.roll.difficulty.open"}}</span>
	</div>

	{{#unless isOpen}}
		<div class="benefit-detriment-grid text-center">
			<span class="pointer benefit {{ifThen parameters.benefit 'active' ''}}" data-action="toggleBenefit">
				{{localize "warden.roll.benefit"}}
			</span>
			<span class="pointer detriment {{ifThen parameters.detriment 'active' ''}}" data-action="toggleDetriment">
				{{localize "warden.roll.detriment"}}
			</span>
		</div>
	{{/unless}}

	<button data-action="execute">
		{{#if isOpen}}
			{{localize
				"warden.roll.submit_label_open"
				formula=formula
			}}
		{{else}}
			{{localize
				"warden.roll.submit_label_difficulty"
				formula=formula
				difficulty=difficulty
			}}
		{{/if}}
	</button>
</section>
