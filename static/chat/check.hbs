<div class="dice-roll" data-action="expandRoll">
	{{#if flavor}}
		<div class="dice-flavor">
			{{ flavor }}
		</div>
	{{/if}}
	{{#unless isOpen}}
		<div>
			<span class="{{ tier_classes }}">
				{{localize
					"warden.roll.result_by"
					result=(localize (concat "warden.roll.result_tier." result_key))
					difference=(numberFormat difference sign=true)
				}}
			</span>
			{{localize
				"warden.roll.vs_difficulty"
				difficulty=difficulty
			}}
		</div>
	{{/unless}}
	{{#if modifiers.length}}
		<div class="modifiers">

			{{#each modifiers}}
				<span class="modifier">
					{{~numberFormat
						value
						sign=true
					~}}:{{#if label.length}}
						{{ label }}
					{{else}}
						{{localize (concat "warden.roll.unnamed_modifier." type)}}
					{{/if}}
				</span>
			{{/each}}
		</div>
	{{/if}}
	<div class="dice-result">
		<div class="dice-formula">{{ formula }}</div>
		{{{ tooltip }}}
		<h4 class="dice-total {{ nat_class }}">{{ total }}</h4>
	</div>
</div>
