<section class="flex-grow tab {{ tab.cssClass }}" data-group="primary" data-tab="description">
	<div class="grid place-stretch" style="height: 100%;">
		<prose-mirror
			name="system.description"
			button="true"
			editable="true"
			toggled="false"
			value="{{ system.description }}"
		>
			{{{ description }}}
		</prose-mirror>
	</div>
</section>
