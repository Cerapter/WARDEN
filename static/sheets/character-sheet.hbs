<section class="character-sheet">
	<!--<img
		class="profile-img"
		src="{{actor.img}}"
		title="{{actor.name}}"
		height="100"
		width="100"
		alt=""
		data-edit="img"
		data-action="editImage"
	/>-->

	{{formInput
		actor.schema.fields.name
		value=actor.name
		classes="col-span-3 gray header"
	}}
	{{formInput
		fields.pronouns
		value=system.pronouns
		classes="gray header"
	}}

	{{formGroup
		fields.level
		value=system.level
		max=10
		type="number"
		classes="black subheader"
	}}
	<div class="white subheader pointer hover-glow" data-action="check" data-type="untrained">
		<label>Untrained Bonus</label>
		<div>
			{{~numberFormat
				untrainedBonus
				sign=true
			~}}
		</div>
	</div>
	<div class="black subheader">
		<label>{{localize "warden.character.sheet.origin"}}</label>

		{{#if system.origins.[0]}}
			<div class="origin" data-item-id="{{ system.origins.[0].id }}">
				{{ system.origins.[0].name }}
			</div>
		{{else}}
			<div>&mdash;</div>
		{{/if}}
	</div>
	<div class="white subheader">
		<label>{{localize "warden.character.sheet.origin"}}</label>

		{{#if system.origins.[1]}}
			<div class="origin" data-item-id="{{ system.origins.[1].id }}">
				{{ system.origins.[1].name }}
			</div>
		{{else}}
			<div>&mdash;</div>
		{{/if}}
	</div>

	<section class="resource-wrapper col-span-2 white text-center">
		<div class="grid row-subgrid row-span-2">
			<div class="slashed value-border flex">
				{{formInput
					fields.hit_points.fields.value
					value=system.hit_points.value
					max=system.hit_points.max
					type="number"
				}}
				<div class="divider"></div>
				<div>{{ system.hit_points.max }}</div>
			</div>
			<label>{{localize "warden.character.hit_points"}}</label>
		</div>

		<div class="grid row-subgrid row-span-4">
			<div class="fate row-span-3 pointer" data-action="clickChanger" data-path="system.fate_points">
				{{> warden-diamonds
					num=3
					filled=system.fate_points
				}}
			</div>
			{{localize "warden.character.fate"}}
		</div>

		<div class="grid row-subgrid row-span-2">
			<div class="slashed value-border flex">
				{{formInput
					fields.strain.fields.value
					value=system.strain.value
					max=system.strain.max
					type="number"
				}}
				<div class="divider"></div>
				<div>{{ system.strain.max }}</div>
			</div>
			<label>{{localize "warden.character.strain"}}</label>
		</div>

		<!-- These two are pretty weird right now -->
		<div class="grid row-subgrid row-span-2">
			<div class="slashed value-border flex">
				<div>{{ system.speed.value }}</div>
				<div class="divider"></div>
				<div>{{ system.speed.base }}</div>
			</div>
			<label>{{localize "warden.character.speed"}}</label>
		</div>
		<div class="grid row-subgrid row-span-2">
			<div class="value-border grid place-center">{{localize (warden-size-loc-key system.size)}}</div>
			<label>{{localize "warden.character.size.label"}}</label>
		</div>
	</section>

	{{formGroup
		fields.description
		value=system.description
		elementType="textarea"
		classes="col-span-2 white tag-label textarea-grow"
	}}

	<div class="flow-col col-span-2">
		<section class="path-defense-wrapper gray col-span-2">
			{{> "systems/warden/static/partials/proficiency-display.hbs"
				path.combat
			}}
			{{> "systems/warden/static/partials/proficiency-display.hbs"
				defense.toughness
			}}

			{{> "systems/warden/static/partials/proficiency-display.hbs"
				path.skill
			}}
			{{> "systems/warden/static/partials/proficiency-display.hbs"
				defense.resolve
			}}

			{{> "systems/warden/static/partials/proficiency-display.hbs"
				path.special
			}}
			{{> "systems/warden/static/partials/proficiency-display.hbs"
				defense.perception
			}}
		</section>

		<section class="grid col-subgrid col-span-2">
			<header class="black text-center bold col-span-2">{{localize "warden.character.sheet.equipment"}}</header>

			<div class="wealth-wrapper white col-span-2 text-center">
				<div class="grid row-subgrid col-subgrid row-span-2 col-span-3">
					<div class="slashed value-border grid col-subgrid col-span-3">
						{{formInput
							fields.vocation.fields.title
							value=system.vocation.title
						}}
						<div class="divider"></div>
						{{formInput
							fields.vocation.fields.value
							value=system.vocation.value
							type="number"
						}}
					</div>

					<label class="col-span-2">{{localize "warden.character.FIELDS.vocation.title.label"}}</label>
					<label>{{localize "warden.character.FIELDS.vocation.value.short"}}</label>
				</div>
				<div class="value-border grid">
					{{formInput
						fields.wealth
						value=system.wealth
						max=system.vocation.value
						type="number"
					}}
				</div>
				<div class="grid place-center pointer" data-action="toggleValue" data-path="system.has_savings">
					{{> warden-diamond
						filled=system.has_savings
					}}
				</div>

				<label>{{localize "warden.character.FIELDS.wealth.label"}}</label>
				<label>{{localize "warden.character.FIELDS.has_savings.label"}}</label>
			</div>
		</section>

		<section class="grid col-subgrid col-span-2 gray inventory-grid">
			<div class="kit equipped equipment-context" data-inventory-area="kit" data-item-id="{{ kit.id }}">
				<span>{{ kit.name }}</span>
				<div class="charges">
					<!-- TODO: Hook up clicks -->
					{{> warden-diamonds
						num=kit.system.charges.max
						filled=kit.system.charges.current
					}}
				</div>
			</div>
			{{#each equipped_items}}
				{{#if this}}
					<div
						class="draggable equipped equipment-context"
						data-inventory-area="equipped"
						data-item-id="{{ id }}"
					>
						{{ name }}
						<div class="equipped-buttons">
							{{#each this.system.equippedButtons}}
								<button>
									{{ label }}
								</button>
							{{/each}}
						</div>
					</div>
				{{else}}
					<div class="equipped" data-inventory-area="equipped" data-empty></div>
				{{/if}}
			{{/each}}

			<header class="col-span-2 bold black text-center">{{localize "warden.character.sheet.pockets"}}</header>
			{{#each pocket_items}}
				{{#if this}}
					<div class="draggable equipment-context" data-inventory-area="pockets" data-item-id="{{ id }}">
						{{ name }}
					</div>
				{{else}}
					<div data-inventory-area="pockets" data-empty></div>
				{{/if}}
			{{/each}}

			<header class="col-span-2 bold black text-center">{{localize "warden.character.sheet.pack"}}</header>
			{{#each pack_items}}
				{{#if this}}
					<div class="draggable equipment-context" data-inventory-area="pack" data-item-id="{{ id }}">
						{{ name }}
					</div>
				{{else}}
					<div data-inventory-area="pack" data-empty></div>
				{{/if}}
			{{/each}}
		</section>
	</div>

	<div class="flow-col col-span-2">
		<section class="skill-wrapper col-span-2 gray">
			<header class="black bold text-center equipment-context">
				{{localize "warden.character.FIELDS.skill.title"}}
			</header>
			<div class="skill-grid">
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.crafting
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.deception
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.diplomacy
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.force
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.intimidation
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.medicine
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.mobility
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.skullduggery
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.stealth
				}}
				{{> "systems/warden/static/partials/skill-display.hbs"
					skill.survival
				}}

				{{#each knowledge_skills}}
					{{#if (eq @index 0)}}
						<hr class="col-span-6" />
					{{/if}}

					{{> "systems/warden/static/partials/knowledge-skill-display.hbs"
						this
					}}
				{{/each}}
			</div>

			<div class="curve-button">
				<button data-action="addKnowledgeSkill"><i class="fa-solid fa-plus"></i></button>
			</div>
		</section>
	</div>

	<!-- TODO: Put this somewhere (likely move speed & size somewhere else and put this there)
	{{formGroup
		fields.temporary_hit_points
		value=system.temporary_hit_points
		type="number"
	}}
	-->
</section>
