<section class="scrollable">
	<img
		class="profile-img"
		src="{{actor.img}}"
		title="{{actor.name}}"
		height="100"
		width="100"
		alt=""
		data-edit="img"
		data-action="editImage"
	/>

	<label>
		{{localize "warden.character.name"}}:
	</label>
	<input type="text" name="name" value="{{actor.name}}" />

	{{formGroup fields.pronouns value=system.pronouns}}
	{{formGroup
		fields.description
		value=system.description
		elementType="textarea"
	}}

	{{formGroup fields.size value=system.size localize=true}}

	{{formGroup fields.level value=system.level max=10 type="number"}}

	{{formGroup
		fields.hit_points.fields.value
		value=system.hit_points.value
		max=10
		type="number"
	}}
	{{formGroup
		fields.temporary_hit_points
		value=system.temporary_hit_points
		type="number"
	}}
	{{formGroup
		fields.strain.fields.value
		value=system.strain.value
		max=10
		type="number"
	}}

	{{formGroup fields.fate_points value=system.fate_points}}

	{{formGroup fields.vocation.fields.title value=system.vocation.title}}
	{{formGroup
		fields.vocation.fields.value
		value=system.vocation.value
		type="number"
	}}

	{{formGroup fields.wealth value=system.wealth}}
	{{formGroup fields.has_savings value=system.has_savings}}

	{{formGroup
		fields.path.fields.combat.fields.rank
		value=system.path.combat.rank
	}}
	{{formGroup
		fields.path.fields.skill.fields.rank
		value=system.path.skill.rank
	}}
	{{formGroup
		fields.path.fields.special.fields.rank
		value=system.path.special.rank
	}}
	{{formGroup
		fields.defense.fields.toughness.fields.rank
		value=system.defense.toughness.rank
	}}
	{{formGroup
		fields.defense.fields.resolve.fields.rank
		value=system.defense.resolve.rank
	}}
	{{formGroup
		fields.defense.fields.perception.fields.rank
		value=system.defense.perception.rank
	}}

	{{formGroup
		fields.skill.fields.crafting.fields.proficient
		value=system.skill.crafting.proficient
	}}
	{{formGroup
		fields.skill.fields.deception.fields.proficient
		value=system.skill.deception.proficient
	}}
	{{formGroup
		fields.skill.fields.diplomacy.fields.proficient
		value=system.skill.diplomacy.proficient
	}}
	{{formGroup
		fields.skill.fields.force.fields.proficient
		value=system.skill.force.proficient
	}}
	{{formGroup
		fields.skill.fields.intimidation.fields.proficient
		value=system.skill.intimidation.proficient
	}}
	{{formGroup
		fields.skill.fields.medicine.fields.proficient
		value=system.skill.medicine.proficient
	}}
	{{formGroup
		fields.skill.fields.mobility.fields.proficient
		value=system.skill.mobility.proficient
	}}
	{{formGroup
		fields.skill.fields.skullduggery.fields.proficient
		value=system.skill.skullduggery.proficient
	}}
	{{formGroup
		fields.skill.fields.stealth.fields.proficient
		value=system.skill.stealth.proficient
	}}
	{{formGroup
		fields.skill.fields.survival.fields.proficient
		value=system.skill.survival.proficient
	}}

	<!-- TODO: Knowledge skill -->
</section>